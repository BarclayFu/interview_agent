# 应用
APP_ENV=dev
CORS_ORIGINS=http://localhost:3000

# 数据层（本地默认值；prod 用托管端点）
# 本机 5432 常被其它项目的 PG 占用，本项目 compose 映射到 5433
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/interview_agent
REDIS_URL=redis://localhost:6379/0

# 观测（留空则不导出）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
OTEL_SERVICE_NAME=interview-agent-api

# LLM（留空 + USE_STUB_LLM=1 则零凭据开发）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL_CHAT=deepseek-chat
LLM_MODEL_REPORT=deepseek-reasoner
USE_STUB_LLM=1

# S3 兼容存储（本地 MinIO 默认值）
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=interview-agent
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# BFF 代理密钥（生产必填；本地留空=不强制）
PROXY_SECRET=
